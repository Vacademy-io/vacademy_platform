{
  "appId": "io.zoeedtech.app",
  "productName": "ZOE Edtech",
  "directories": {
    "buildResources": "resources-zoe",
    "output": "dist-mas-zoe"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "app/**/*",
    "capacitor.config.*",
    "electron-flavor.json",
    "package.json",
    {
      "from": "node_modules",
      "filter": [
        "**/*",
        "!electron/dist/**/*",
        "!electron/**/*",
        "!electron-builder/**/*",
        "!app-builder-lib/**/*",
        "!electron-osx-sign/**/*",
        "!electron-rebuild/**/*",
        "!**/*.md",
        "!**/*.map",
        "!**/test/**",
        "!**/tests/**",
        "!**/.bin/**"
      ]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "compression": "normal",
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "npmRebuild": false,
  "mas": {
    "category": "public.app-category.education",
    "icon": "assets/zoe.icns",
    "target": [
      {
        "target": "pkg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "type": "distribution",
    "entitlements": "entitlements.zoe.mas.plist",
    "entitlementsInherit": "entitlements.mas.inherit.plist",
    "provisioningProfile": "embedded-zoe.provisionprofile",
    "hardenedRuntime": false,
    "identity": "Saurabh Kumar (7XKD5M7288)",
    "minimumSystemVersion": "12.0",
    "entitlementsLoginHelper": "entitlements.mas.loginhelper.plist"
  },
  "extraMetadata": {
    "version": "1.0"
  },
  "buildVersion": "4",
  "mac": {
    "category": "public.app-category.education",
    "icon": "assets/zoe.icns",
    "minimumSystemVersion": "12.0"
  }
}