{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vacademy MCP",
  "description": "Use Claude, ChatGPT, Cursor, Claude Code or VS Code with your institute's data: courses, websites, learners and the CRM. Each person signs in as themselves, and your admin decides what each role can reach.",
  "colors": {
    "primary": "#ED7424",
    "light": "#F19046",
    "dark": "#E26612"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://vacademy.io"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "vacademy.io",
        "href": "https://vacademy.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "for-counsellors",
              "how-it-works"
            ]
          },
          {
            "group": "Connect your AI app",
            "pages": [
              "connect/claude",
              "connect/claude-code",
              "connect/chatgpt",
              "connect/cursor",
              "connect/vscode",
              "connect/other-apps"
            ]
          },
          {
            "group": "Settings and access",
            "pages": [
              "settings/enable-the-server",
              "settings/roles",
              "settings/areas-and-levels",
              "settings/risk-levels",
              "settings/opt-in-features",
              "settings/connections-and-revoking",
              "settings/client-ids"
            ]
          },
          {
            "group": "Working with it",
            "pages": [
              "usage/confirmations",
              "usage/drafts-vs-live",
              "usage/prompting-tips",
              "usage/playbooks",
              "usage/errors",
              "usage/troubleshooting"
            ]
          },
          {
            "group": "Technical: sign-in (OAuth)",
            "pages": [
              "oauth/how-sign-in-works",
              "oauth/institute-server-url",
              "oauth/tokens-and-expiry"
            ]
          }
        ]
      },
      {
        "tab": "Tools",
        "icon": "wrench",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "tools/catalogue"
            ]
          },
          {
            "group": "LMS",
            "pages": [
              "tools/identity",
              "tools/institute",
              "tools/website",
              "tools/lead-forms",
              "tools/automations",
              "tools/blog",
              "tools/courses",
              "tools/learners",
              "tools/learner-reports"
            ]
          },
          {
            "group": "CRM",
            "pages": [
              "tools/crm-leads",
              "tools/crm-calls",
              "tools/crm-meetings",
              "tools/crm-messages",
              "tools/crm-reports"
            ]
          }
        ]
      },
      {
        "tab": "Security",
        "icon": "shield-check",
        "groups": [
          {
            "group": "Security and privacy",
            "pages": [
              "security/overview",
              "security/data-and-pii",
              "security/audit-log",
              "security/prompt-injection",
              "security/guardrails"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "clock",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://vacademy.io"
    }
  },
