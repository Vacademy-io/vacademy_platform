{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vacademy Docs",
  "description": "Developer and admin docs for Vacademy: the Catalogue API for your own website, and the MCP server that lets Claude, ChatGPT and Cursor work with your institute's courses, learners and CRM.",
  "colors": {
    "primary": "#ED7424",
    "light": "#F4A06A",
    "dark": "#C95A12"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://vacademy.io"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Plus Jakarta Sans"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "vacademy.io",
        "href": "https://vacademy.io"
      },
      {
        "label": "Support",
        "href": "mailto:support@vacademy.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dash.vacademy.io"
    }
  },
  "navigation": {
    "products": [
      {
        "product": "Catalogue API",
        "description": "Courses and enquiries on your own website",
        "icon": "book-open",
        "tabs": [
          {
            "tab": "Documentation",
            "icon": "book-open",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "introduction",
                  "quickstart",
                  "keys-and-websites"
                ]
              },
              {
                "group": "Concepts",
                "pages": [
                  "concepts/courses",
                  "concepts/streams-and-learning-paths",
                  "concepts/course-pages-and-seo"
                ]
              },
              {
                "group": "Guides",
                "pages": [
                  "guides/enquiries",
                  "guides/going-live"
                ]
              },
              {
                "group": "Platform",
                "pages": [
                  "platform/errors",
                  "platform/rate-limits-and-caching",
                  "platform/versioning",
                  "platform/changelog"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "icon": "square-terminal",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "api-reference/introduction"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": "api-reference/openapi.json"
              }
            ]
          }
        ]
      },
      {
        "product": "MCP server",
        "description": "Use Claude, ChatGPT or Cursor with your institute",
        "icon": "robot",
        "tabs": [
          {
            "tab": "Guides",
            "icon": "book-open",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "mcp/introduction",
                  "mcp/quickstart",
                  "mcp/for-counsellors",
                  "mcp/how-it-works"
                ]
              },
              {
                "group": "Connect your AI app",
                "pages": [
                  "mcp/connect/claude",
                  "mcp/connect/claude-code",
                  "mcp/connect/chatgpt",
                  "mcp/connect/cursor",
                  "mcp/connect/vscode",
                  "mcp/connect/other-apps"
                ]
              },
              {
                "group": "Settings and access",
                "pages": [
                  "mcp/settings/enable-the-server",
                  "mcp/settings/roles",
                  "mcp/settings/areas-and-levels",
                  "mcp/settings/risk-levels",
                  "mcp/settings/opt-in-features",
                  "mcp/settings/connections-and-revoking",
                  "mcp/settings/client-ids"
                ]
              },
              {
                "group": "Working with it",
                "pages": [
                  "mcp/usage/confirmations",
                  "mcp/usage/drafts-vs-live",
                  "mcp/usage/prompting-tips",
                  "mcp/usage/playbooks",
                  "mcp/usage/errors",
                  "mcp/usage/troubleshooting"
                ]
              },
              {
                "group": "Technical: sign-in (OAuth)",
                "pages": [
                  "mcp/oauth/how-sign-in-works",
                  "mcp/oauth/institute-server-url",
                  "mcp/oauth/tokens-and-expiry"
                ]
              }
            ]
          },
          {
            "tab": "Tools",
            "icon": "wrench",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "mcp/tools/catalogue"
                ]
              },
              {
                "group": "LMS",
                "pages": [
                  "mcp/tools/identity",
                  "mcp/tools/institute",
                  "mcp/tools/website",
                  "mcp/tools/lead-forms",
                  "mcp/tools/automations",
                  "mcp/tools/blog",
                  "mcp/tools/courses",
                  "mcp/tools/learners",
                  "mcp/tools/learner-reports"
                ]
              },
              {
                "group": "CRM",
                "pages": [
                  "mcp/tools/crm-leads",
                  "mcp/tools/crm-calls",
                  "mcp/tools/crm-meetings",
                  "mcp/tools/crm-messages",
                  "mcp/tools/crm-reports"
                ]
              }
            ]
          },
          {
            "tab": "Security",
            "icon": "shield-check",
            "groups": [
              {
                "group": "Security and privacy",
                "pages": [
                  "mcp/security/overview",
                  "mcp/security/data-and-pii",
                  "mcp/security/audit-log",
                  "mcp/security/prompt-injection",
                  "mcp/security/guardrails"
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "icon": "clock",
            "groups": [
              {
                "group": "Changelog",
                "pages": [
                  "mcp/changelog"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/catalog",
      "destination": "/introduction"
    },
    {
      "source": "/mcp/security/for-counsellors",
      "destination": "/mcp/for-counsellors"
    },
    {
      "source": "/mcp",
      "destination": "/mcp/introduction"
    }
  ],
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    },
    "mdx": {
      "server": "https://api.vacademy.ai/catalog/v1",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://vacademy.io"
    }
  },
  "seo": {
    "indexing": "navigable"
  }
}
